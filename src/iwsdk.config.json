{
  "$schema": "../node_modules/@iwsdk/core/dist/schemas/iwsdk-project.v1.schema.json",
  "version": "iwsdk.project.v1",
  "scene": "./public/scenes/juego.iwsdk.scene.json",
  "world": {
    "xr": {
      "mode": "ar",
      "offer": "none",
      "launchOnSessionGranted": true,
      "features": {
        "handTracking": true,
        "anchors": true,
        "hitTest": true,
        "planeDetection": true,
        "meshDetection": true
      }
    },
    "input": {
      "canvasPointerEvents": true
    },
    "render": {
      "fov": 60,
      "near": 0.01,
      "far": 100,
      "camera": {
        "position": [0, 1.35, 0.55],
        "lookAt": [0, 0.78, -0.35]
      }
    },
    "features": {
      "locomotion": false,
      "grabbing": { "useHandPinchForGrab": true },
      "physics": false,
      "sceneUnderstanding": { "showWireFrame": false },
      "environmentRaycast": true,
      "spatialUI": true
    }
  },
  "dev": {
    "emulator": {
      "device": "metaQuest3",
      "environment": "sunlit_living_room"
    }
  }
}
